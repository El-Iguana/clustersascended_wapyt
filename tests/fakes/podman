#!/usr/bin/env python3
"""
A fake podman for orchestrator tests. State lives in $FAKE_PODMAN_STATE/state.json:

    {"containers": {"<name>": {"state": "exited", "started_at": 0, "saved_dir": "...",
                               "on_start": "ready" | "hang" | "exit" | "silent",
                               "ready_gb": 16.5}}}

``start`` marks the container running and, per ``on_start``, appends a
stamped "advertising for join" (or "Hang detected") line to its
ShooterGame.log, or leaves it exited.
"""
import json
import os
import sys
import time
from datetime import datetime, timezone
from pathlib import Path

STATE = Path(os.environ["FAKE_PODMAN_STATE"]) / "state.json"


def load():
    return json.loads(STATE.read_text())


def save(data):
    STATE.write_text(json.dumps(data))


def log(saved_dir, text):
    p = Path(saved_dir) / "Logs" / "ShooterGame.log"
    p.parent.mkdir(parents=True, exist_ok=True)
    now = datetime.now(timezone.utc)
    stamp = now.strftime("[%Y.%m.%d-%H.%M.%S:") + f"{now.microsecond // 1000:03d}][  1]"
    with open(p, "a") as fh:
        fh.write(stamp + text + "\n")


def args_i_is_script(argv, i):
    return i >= 2 and argv[i - 1] == "-c"


def main(argv):
    data = load()
    cmd = argv[0]
    with open(Path(os.environ["FAKE_PODMAN_STATE"]) / "calls.log", "a") as fh:
        fh.write(" ".join(argv) + "\n")
    if cmd == "unshare":   # run the command as is; ownership changes are no-ops here
        import subprocess
        args = [a.replace("chown", "true") if args_i_is_script(argv, i) else a
                for i, a in enumerate(argv[1:], start=1)]
        return subprocess.run(args).returncode
    if cmd == "ps":
        out = [{"Names": [n], "State": c["state"], "StartedAt": c.get("started_at", 0),
                "Id": "id-" + n, "ExitCode": c.get("exit_code", 0), "Labels": c.get("labels") or {}}
               for n, c in data["containers"].items()]
        print(json.dumps(out))
        return 0
    if cmd == "create":
        args = argv[1:]
        name, labels, mounts, env_file = None, {}, {}, None
        i = 0
        while i < len(args):
            a = args[i]
            if a == "--name":
                name = args[i + 1]; i += 2; continue
            if a == "--label":
                k, _, v = args[i + 1].partition("="); labels[k] = v; i += 2; continue
            if a == "-v":
                src, _, dst = args[i + 1].partition(":"); mounts[dst] = src; i += 2; continue
            if a == "--env-file":
                env_file = args[i + 1]; i += 2; continue
            if a.startswith("--"):
                i += 2; continue
            i += 1
        if name in data["containers"]:
            print(f"Error: the container name \"{name}\" is already in use", file=sys.stderr)
            return 125
        env = dict(line.split("=", 1) for line in Path(env_file).read_text().splitlines() if "=" in line)
        template = data.get("defaults", {}).get(name, {})
        data["containers"][name] = {**template, "state": "created", "started_at": 0, "labels": labels,
                                    "saved_dir": mounts["/home/pok/arkserver/ShooterGame/Saved"],
                                    "env": env, "argv": argv}
        save(data)
        print("id-" + name)
        return 0
    if cmd == "rename":
        old, new = argv[1], argv[2]
        if old not in data["containers"] or new in data["containers"]:
            print("Error: rename refused", file=sys.stderr)
            return 125
        data["containers"][new] = data["containers"].pop(old)
        save(data)
        return 0
    name = argv[-1]
    c = data["containers"].get(name)
    if c is None:
        print(f"Error: no container with name or ID \"{name}\" found", file=sys.stderr)
        return 125
    if cmd == "inspect":
        print(json.dumps([{"Name": name, "State": {"Status": c["state"], "Running": c["state"] == "running",
                                                   "CgroupPath": "", "ExitCode": c.get("exit_code", 0)},
                           "Config": {"Labels": c.get("labels") or {}}}]))
        return 0
    if cmd == "rm":
        if c["state"] == "running":
            print("Error: container is running", file=sys.stderr)
            return 2
        del data["containers"][name]
        save(data)
        return 0
    if cmd == "crash":   # test helper: the process dies on its own
        c["state"], c["exit_code"] = "exited", 139
        save(data)
        return 0
    if cmd == "start":
        if c.get("start_delay"):
            time.sleep(c["start_delay"])
        c["started_at"] = int(time.time())
        # ASA starts a fresh ShooterGame.log on every boot.
        current = Path(c["saved_dir"]) / "Logs" / "ShooterGame.log"
        if current.exists():
            current.rename(current.with_name(f"ShooterGame-backup-{time.time_ns()}.log"))
        mode = c.get("on_start", "ready")
        if c.get("on_start_seq"):          # e.g. ["exit", "ready"]: one per start
            mode = c["on_start_seq"].pop(0)
        if mode == "exit":
            c["state"], c["exit_code"] = "exited", 1
        else:
            c["state"] = "running"
            if mode == "ready":
                log(c["saved_dir"], "Server has completed startup and is now advertising for join. "
                    f"({c.get('ready_gb', 16.5):.2f}GB Mem)")
            elif mode == "hang":
                log(c["saved_dir"], "Hang detected on GameThread (10.0 seconds)")
        save(data)
        print(name)
        return 0
    if cmd == "stop":
        c["state"], c["exit_code"] = "exited", 0
        save(data)
        print(name)
        return 0
    print(f"fake podman: unsupported {argv}", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
