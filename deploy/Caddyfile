# HTTPS in front of Clusters Ascended for the LAN. pytincture only allows
# sign-in over HTTPS off loopback, so Caddy terminates TLS with its own local
# CA ("tls internal") and forwards to the app on 127.0.0.1:8098.
#
# Browsers warn once, until Caddy's root certificate is trusted:
#   ~/.local/share/caddy/pki/authorities/local/root.crt
#
# CA_LAN_HOST / CA_LAN_PORT come from the systemd unit.
{
	skip_install_trust
	admin localhost:2099
	# A user service cannot bind :80 for the http→https redirect.
	auto_https disable_redirects
}

https://{$CA_LAN_HOST:192.168.1.97}:{$CA_LAN_PORT:8099} {
	tls internal
	reverse_proxy 127.0.0.1:8098
}
